<Project Sdk="Microsoft.NET.Sdk">

  <!-- Platform-neutral tracker, storage, and report code shared by the Windows and Mac apps.
       Targets net10.0 (LTS); the Windows app targets net10.0-windows10.0.19041.0 and the Mac app net10.0. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ComputerUse.TimeTracking</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.12" />
    <PackageReference Include="PDFsharp" Version="6.2.2" />
    <!-- PDFsharp depends on System.Security.Cryptography.Pkcs 8.0.1 (GHSA-846f-f764-76mx,
         GHSA-2fmv-rv2c-59x7). Lift it to a patched version for every project that uses Core. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!-- Older Microsoft.Data.Sqlite builds shipped native SQLite 2.1.6, which has a known advisory;
         keep the patched 2.1.x native build pinned. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.14" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ComputerUse.TimeTracking.Core.Tests" />
  </ItemGroup>

</Project>
