<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 desktop rescap">
  <!-- Publisher must equal the signing certificate subject exactly, or installation fails.
       build-msix.ps1 replaces the placeholder and the version. -->
  <Identity
	Name="ComputerUse.TimeTracking"
	Publisher="CN=REPLACE_WITH_SIGNING_CERT_SUBJECT"
	Version="1.0.0.0"
	ProcessorArchitecture="x64" />
  <Properties>
	<DisplayName>Computer Use Time Tracker</DisplayName>
	<PublisherDisplayName>Computer Use Time Tracking contributors</PublisherDisplayName>
	<Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
	<TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Resources>
	<Resource Language="en-us" />
  </Resources>
  <Applications>
	<Application Id="ComputerUseTimeTracker" Executable="ComputerUse.TimeTracking.exe" EntryPoint="Windows.FullTrustApplication">
	  <uap:VisualElements
		DisplayName="Computer Use Time Tracker"
		Description="Tracks which apps you work in and saves a daily PDF report on this PC."
		BackgroundColor="transparent"
		Square150x150Logo="Assets\Square150x150Logo.png"
		Square44x44Logo="Assets\Square44x44Logo.png" />
	  <Extensions>
		<!-- Takes effect after the user has launched the app once (App Installer's "Launch when
		     ready" does that). The user can turn it off in Task Manager; Settings shows the state. -->
		<desktop:Extension Category="windows.startupTask" Executable="ComputerUse.TimeTracking.exe" EntryPoint="Windows.FullTrustApplication">
			<desktop:StartupTask TaskId="ComputerUseTimeTracking" Enabled="true" DisplayName="Computer Use Time Tracker" />
		</desktop:Extension>
		<!-- Stable command-line alias for launching the desktop app. -->
		<uap5:Extension Category="windows.appExecutionAlias" Executable="ComputerUse.TimeTracking.exe" EntryPoint="Windows.FullTrustApplication">
			<uap5:AppExecutionAlias>
				<uap5:ExecutionAlias Alias="computer-use-time-tracking.exe" />
			</uap5:AppExecutionAlias>
		</uap5:Extension>
	  </Extensions>
	</Application>
  </Applications>
  <Capabilities>
	<rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
