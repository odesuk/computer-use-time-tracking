<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <OutputType Condition="'$(BuildingAsDependency)' != 'true'">WinExe</OutputType>
    <OutputType Condition="'$(BuildingAsDependency)' == 'true'">Library</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>ComputerUse.TimeTracking</RootNamespace>
    <AssemblyName>ComputerUse.TimeTracking</AssemblyName>
    <ApplicationIcon>..\..\installer\Assets\AppIcon.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>Computer Use Time Tracker</Product>
    <Company>Computer Use Time Tracking contributors</Company>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <EmbeddedResource Include="..\..\installer\Assets\AppIcon.ico" LogicalName="ComputerUse.TimeTracking.AppIcon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageReference Include="Microsoft.Office.Interop.Outlook" Version="15.0.4797.1004" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ComputerUse.TimeTracking.Windows.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\ComputerUse.TimeTracking.Core.csproj" />
  </ItemGroup>
</Project>
